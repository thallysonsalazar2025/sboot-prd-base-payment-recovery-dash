# Caminho local do frontend (não copia arquivos para este repositório)
FRONTEND_PATH=C:/Workspace/react-payment-recovery-ashboard

# Portas expostas
FRONTEND_PORT=3000
BACKEND_DASHBOARD_PORT=8080
API_GATEWAY_PORT=8081
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# RabbitMQ
RABBITMQ_DEFAULT_USER=payroll
RABBITMQ_DEFAULT_PASS=payroll

# Sobrescreva as imagens conforme seu registry
PAYROLL_QUERY_IMAGE=ghcr.io/company/sboot-payroll-query-service:latest
PAYROLL_ORCHESTRATOR_IMAGE=ghcr.io/company/boot-payroll-orchestrator-service:latest
PAYROLL_REQUEST_PUBLISHER_IMAGE=ghcr.io/company/payroll-generation-request-publisher:latest
SECURITY_AUTH_IMAGE=ghcr.io/company/sboot-security-base-auth-service:latest
PAYROLL_PROCESSOR_IMAGE=ghcr.io/company/sboot-payroll-generation-processor:latest
API_GATEWAY_IMAGE=ghcr.io/company/sboot-security-base-api-gateway:latest
PAYROLL_CALCULATION_IMAGE=ghcr.io/company/sboot-payroll-calculation-service:latest
DATA_EMPLOYEE_IMAGE=ghcr.io/company/sboot-data-employe-serice:latest
DATA_COMPANY_IMAGE=ghcr.io/company/sboot-data-company-serice:latest
PAYROLL_EVENTS_IMAGE=ghcr.io/company/sboot-payroll-events-service:latest
PAYROLL_VALIDATION_IMAGE=ghcr.io/company/sboot-payroll-validation-service:latest
TIME_TRACKING_IMAGE=ghcr.io/company/sboot-time-tracking-integration-service:latest
BACKEND_DASHBOARD_IMAGE=sboot-prd-base-payment-recovery-dash:latest
